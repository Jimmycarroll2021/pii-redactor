# GBNF grammar for Australian government PII extraction.
#
# Pass this to llama.cpp via the --grammar-file flag, or via the
# "grammar" field on the /completion HTTP endpoint.
#
# This grammar guarantees the model output will be valid JSON of the form:
#   {"pii": [{"category": "tfn", "value": "123 456 782"}, ...]}
#
# This file is generated by pii_redactor.grammar.build_grammar() at runtime,
# but a static copy is included here so it can be reviewed or modified
# independently of the Python code.

root        ::= "{" ws "\"pii\":" ws "[" ws (entity (ws "," ws entity)*)? ws "]" ws "}"
entity      ::= "{" ws "\"category\":" ws category ws "," ws "\"value\":" ws string ws "}"
category    ::= "\"name\"" | "\"date_of_birth\"" | "\"date\"" | "\"address\""
              | "\"phone\"" | "\"email\"" | "\"url\"" | "\"ip_address\""
              | "\"tfn\"" | "\"medicare\"" | "\"abn\"" | "\"acn\""
              | "\"driver_licence\"" | "\"passport\"" | "\"bsb_account\""
              | "\"centrelink_crn\""
string      ::= "\"" char* "\""
char        ::= [^"\\] | "\\" ( ["\\/bfnrt] | "u" [0-9a-fA-F]{4} )
ws          ::= [ \t\n]*
