# PII Redactor — environment variables
#
# Copy this file to .env and fill in real values.
# Generate keys with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"  # for API key
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"  # for audit key

# -------- Backend selection
# One of: mock | llama_cpp | hf | ollama
PIIR_BACKEND=llama_cpp

# -------- llama.cpp server (when PIIR_BACKEND=llama_cpp)
PIIR_LLAMA_CPP_URL=http://localhost:8080
PIIR_LLAMA_CPP_MODEL=llama-3-8b-instruct

# -------- Hugging Face Inference (when PIIR_BACKEND=hf)
PIIR_HF_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct
PIIR_HF_TOKEN=

# -------- API authentication
PIIR_REQUIRE_PRODUCTION_SAFETY=true
PIIR_REQUIRE_API_KEY=true
PIIR_API_KEY=
PIIR_REIDENTIFY_API_KEY=

# -------- API limits / concurrency
PIIR_MAX_TEXT_CHARS=200000
PIIR_MAX_BATCH_DOCS=1000
PIIR_MAX_CONCURRENCY=8

# -------- Audit log
PIIR_AUDIT_ENABLED=true
PIIR_AUDIT_PATH=./audit.jsonl
PIIR_AUDIT_KEY=

# -------- Detection tuning
PIIR_CHUNK_SIZE=4000
PIIR_CHUNK_OVERLAP=200
PIIR_TEMPERATURE=0.1
PIIR_MAX_TOKENS=2048
PIIR_FAIL_ON_LLM_ERROR=true

# -------- Ollama local inference (when PIIR_BACKEND=ollama)
PIIR_OLLAMA_URL=http://localhost:11434
PIIR_OLLAMA_MODEL=qwen2.5:7b

# -------- Redaction
# numbered | category | asterisk
PIIR_PLACEHOLDER_STYLE=numbered
